{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gv-bizwatch4551",
  "account_id": "965c1c780f1112c441a6884f202f81c3",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-03-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bizwatch-4551",
      "database_id": "9a296306-c972-4ee6-b917-199dffb71c04",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "bizwatch-4551-media"
    }
  ],
  "vars": {
    "APP_NAME": "BizWatch",
    "REGION_LABEL": "Caloundra & 4551",
    "APP_URL": "https://bizwatch4551.com.au"
    // Twilio credentials must NOT be listed here (they would be public in git).
    // Set once with: node scripts/sync-twilio-secrets.mjs
    // (reads .dev.vars and runs `wrangler secret put` for each key)
  }
}
